# ── Shared secret ────────────────────────────────────────────────────────────
# One token guards both the device WS endpoint and the agent/MCP API.
# Generate one with:  openssl rand -hex 32
PHONE_MCP_TOKEN=change-me-to-a-long-random-string

# ── Server ───────────────────────────────────────────────────────────────────
# Port the broker listens on (devices connect here, MCP talks to here).
PORT=8080
# Public host (optional, only used for log hints / QR output).
PUBLIC_URL=

# How long (ms) to wait for a device to answer a command before giving up.
COMMAND_TIMEOUT_MS=15000
# Device is considered offline if no heartbeat within this window (ms).
HEARTBEAT_TIMEOUT_MS=45000

# ── MCP ──────────────────────────────────────────────────────────────────────
# Base URL of the broker server the MCP should drive.
PHONE_MCP_SERVER_URL=http://localhost:8080
# Token the MCP uses to authenticate to the server (defaults to PHONE_MCP_TOKEN).
# PHONE_MCP_TOKEN is reused if this is unset.
